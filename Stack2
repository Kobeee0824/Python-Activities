class Stack:
    def __init__(self):
        self.stack = []

    # Push element onto stack
    def push(self, item):
        self.stack.append(item)

    # Pop element from stack
    def pop(self):
        if self.is_empty():
            return "Stack is empty"
        return self.stack.pop()

    # Peek top element
    def peek(self):
        if self.is_empty():
            return "Stack is empty"
        return self.stack[-1]

    # Check if stack is empty
    def is_empty(self):
        return len(self.stack) == 0

    # Get stack size
    def size(self):
        return len(self.stack)


# Example usage
s = Stack()

s.push(10)
s.push(20)
s.push(30)

print("Top element:", s.peek())   # 30
print("Removed:", s.pop())        # 30
print("Stack size:", s.size())    # 2
